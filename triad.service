[Unit]
Description=Triad card game
After=network.target

[Service]
Type=simple
User=triad
WorkingDirectory=/opt/triad
Environment=PORT=8080
ExecStart=/usr/bin/node /opt/triad/server.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
